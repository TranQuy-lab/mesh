<script nonce="dff7c387b9628973095ef5bd6add9108">
(function () {
	function animateStat(el) {
		if (el.dataset.animated) {return;}
		el.dataset.animated = "1";

		var target = parseFloat(el.dataset.target) || 0;
		var symbol = el.dataset.symbol || "";
		var isFloat = String(el.dataset.target).indexOf(".") !== -1;
		var decimals = isFloat ? (String(el.dataset.target).split(".")[1] || "").length : 0;
		var current = 0;

		function step() {
			if (current <= 0) {
				current = Math.max(target * 0.02, 1);
			}
			var incrementPct = 0.10 + Math.random() * 0.05; // random 10%-15%
			current += target * incrementPct;

			if (current >= target) {
				el.textContent = target.toFixed(decimals) + symbol;
				return;
			}

			el.textContent = current.toFixed(decimals) + symbol;
			window.requestAnimationFrame(function () {
				setTimeout(step, 100);
			});
		}

		setTimeout(step, 150);
	}

	function initStatsBanners() {
		var counters = document.querySelectorAll(".stats-banner .js-stat-count");
		if (!counters.length) {return;}

		if (!("IntersectionObserver" in window)) {
			counters.forEach(animateStat);
			return;
		}

		var observer = new IntersectionObserver(function (entries) {
			entries.forEach(function (entry) {
				if (entry.isIntersecting) {
					animateStat(entry.target);
					observer.unobserve(entry.target);
				}
			});
		}, { threshold: 0.4 });

		counters.forEach(function (el) {observer.observe(el);});
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initStatsBanners);
	} else {initStatsBanners();}
})();
</script>

