<h3><a name="_Toc189182037"></a><a name="_Toc158708679"></a><span lang=EN>4.1.8
</span><span lang=EN>OwnershipInformation Element</span></h3>

<table class=MsoNormalTable border=1 cellspacing=0 cellpadding=0 width="97%"
 style='width:97.32%'>
 <tr>
  <td width="15%" valign=top style='width:15.26%;background:#CCCCEE;padding:
  3.0pt 3.0pt 3.0pt 3.0pt'>
  <p class=MsoNormal><b>Element</b></p>
  </td>
  <td width="84%" style='width:84.74%;padding:3.0pt 3.0pt 3.0pt 3.0pt'>
  <p class=MsoNormal>Owner</p>
  </td>
 </tr>
 <tr>
  <td width="15%" valign=top style='width:15.26%;background:#CCCCEE;padding:
  3.0pt 3.0pt 3.0pt 3.0pt'>
  <p class=MsoNormal>Type</p>
  </td>
  <td width="84%" valign=top style='width:84.74%;padding:3.0pt 3.0pt 3.0pt 3.0pt'>
  <p class=MsoNormal>OwnerType [xsd:string]</p>
  </td>
 </tr>
 <tr>
  <td width="15%" valign=top style='width:15.26%;background:#CCCCEE;padding:
  3.0pt 3.0pt 3.0pt 3.0pt'>
  <p class=MsoNormal>Usage</p>
  </td>
  <td width="84%" valign=top style='width:84.74%;padding:3.0pt 3.0pt 3.0pt 3.0pt'>
  <p class=MsoNormal><b>CONDITIONAL</b>, MAY be used once and only once </p>
  </td>
 </tr>
 <tr>
  <td width="15%" valign=top style='width:15.26%;background:#CCCCEE;padding:
  3.0pt 3.0pt 3.0pt 3.0pt'>
  <p class=MsoNormal>Definition</p>
  </td>
  <td width="84%" valign=top style='width:84.74%;padding:3.0pt 3.0pt 3.0pt 3.0pt'>
  <p class=MsoNormal>The name of an agency or supplier that owns the resource (which
  may not be the home unit or dispatch). Also referred to as home agency.</p>
  <p class=MsoNormal>&nbsp;</p>
  </td>
 </tr>
 <tr>
  <td width="15%" valign=top style='width:15.26%;background:#CCCCEE;padding:
  3.0pt 3.0pt 3.0pt 3.0pt'>
  <p class=MsoNormal>Constraints</p>
  </td>
  <td width="84%" valign=top style='width:84.74%;padding:3.0pt 3.0pt 3.0pt 3.0pt'>
  <ul style='margin-top:0in' type=square>
   <li class=MsoNormal>At least one of OwnershipInformation:Owner or
       OwnershipInformation:OwningJurisdiction MUST be present for each
       OwnershipInformation element.</li>
  </ul>
  <p class=MsoNormal>&nbsp;</p>
  </td>
 </tr>
 <tr>
  <td width="15%" valign=top style='width:15.26%;background:#CCCCEE;padding:
  3.0pt 3.0pt 3.0pt 3.0pt'>
  <p class=MsoNormal>Requirements Supported</p>
  </td>
  <td width="84%" style='width:84.74%;padding:3.0pt 3.0pt 3.0pt 3.0pt'>
  <p class=MsoNormal>3,16,18</p>
  </td>
 </tr>
</table>

<p class=MsoNormal><span lang=EN>&nbsp;</span></p>

<table class=MsoNormalTable border=1 cellspacing=0 cellpadding=0 width="97%"
 style='width:97.32%'>
 <tr>
  <td width="15%" valign=top style='width:15.26%;background:#CCCCEE;padding:
  3.0pt 3.0pt 3.0pt 3.0pt'>
  <p class=MsoNormal><b>Element</b></p>
  </td>
  <td width="84%" style='width:84.74%;padding:3.0pt 3.0pt 3.0pt 3.0pt'>
  <p class=MsoNormal>OwningJurisdiction</p>
  </td>
 </tr>
 <tr>
  <td width="15%" valign=top style='width:15.26%;background:#CCCCEE;padding:
  3.0pt 3.0pt 3.0pt 3.0pt'>
  <p class=MsoNormal>Type</p>
  </td>
  <td width="84%" valign=top style='width:84.74%;padding:3.0pt 3.0pt 3.0pt 3.0pt'>
  <p class=MsoNormal>OwningJurisdictionType [xsd:string]</p>
  </td>
 </tr>
 <tr>
  <td width="15%" valign=top style='width:15.26%;background:#CCCCEE;padding:
  3.0pt 3.0pt 3.0pt 3.0pt'>
  <p class=MsoNormal>Usage</p>
  </td>
  <td width="84%" valign=top style='width:84.74%;padding:3.0pt 3.0pt 3.0pt 3.0pt'>
  <p class=MsoNormal><b>CONDITIONAL</b>, MAY be used once and only once</p>
  </td>
 </tr>
 <tr>
  <td width="15%" valign=top style='width:15.26%;background:#CCCCEE;padding:
  3.0pt 3.0pt 3.0pt 3.0pt'>
  <p class=MsoNormal>Definition</p>
  </td>
  <td width="84%" valign=top style='width:84.74%;padding:3.0pt 3.0pt 3.0pt 3.0pt'>
  <p class=MsoNormal>A geopolitical area in which an organization, person, or
  object has a specific range of authority for specified resources.</p>
  </td>
 </tr>
 <tr>
  <td width="15%" valign=top style='width:15.26%;background:#CCCCEE;padding:
  3.0pt 3.0pt 3.0pt 3.0pt'>
  <p class=MsoNormal>Constraints</p>
  </td>
  <td width="84%" valign=top style='width:84.74%;padding:3.0pt 3.0pt 3.0pt 3.0pt'>
  <ul style='margin-top:0in' type=disc>
   <li class=MsoNormal>At least one of OwnershipInformation:Owner or
       OwnershipInformation:OwningJurisdiction MUST be present for each
       OwnershipInformation element.</li>
  </ul>
  </td>
 </tr>
 <tr>
  <td width="15%" valign=top style='width:15.26%;background:#CCCCEE;padding:
  3.0pt 3.0pt 3.0pt 3.0pt'>
  <p class=MsoNormal>Comments</p>
  </td>
  <td width="84%" valign=top style='width:84.74%;padding:3.0pt 3.0pt 3.0pt 3.0pt'>
  <ul style='margin-top:0in' type=disc>
   <li class=MsoNormal>Can be a code</li>
  </ul>
  </td>
 </tr>
 <tr>
  <td width="15%" valign=top style='width:15.26%;background:#CCCCEE;padding:
  3.0pt 3.0pt 3.0pt 3.0pt'>
  <p class=MsoNormal>Requirements Supported</p>
  </td>
  <td width="84%" style='width:84.74%;padding:3.0pt 3.0pt 3.0pt 3.0pt'>
  <p class=MsoNormal>3, 16, 18</p>
  </td>
 </tr>
</table>

<p class=MsoNormal><span lang=EN>&nbsp;</span></p>

<table class=MsoNormalTable border=1 cellspacing=0 cellpadding=0 width="97%"
 style='width:97.32%'>
 <tr>
  <td width="15%" valign=top style='width:15.26%;background:#CCCCEE;padding:
  3.0pt 3.0pt 3.0pt 3.0pt'>
  <p class=MsoNormal><b>Element</b></p>
  </td>
  <td width="84%" style='width:84.74%;padding:3.0pt 3.0pt 3.0pt 3.0pt'>
  <p class=MsoNormal>HomeDispatch</p>
  </td>
 </tr>
 <tr>
  <td width="15%" valign=top style='width:15.26%;background:#CCCCEE;padding:
  3.0pt 3.0pt 3.0pt 3.0pt'>
  <p class=MsoNormal>Type</p>
  </td>
  <td width="84%" valign=top style='width:84.74%;padding:3.0pt 3.0pt 3.0pt 3.0pt'>
  <p class=MsoNormal>HomeDispatchType [xsd:string]</p>
  </td>
 </tr>
 <tr>
  <td width="15%" valign=top style='width:15.26%;background:#CCCCEE;padding:
  3.0pt 3.0pt 3.0pt 3.0pt'>
  <p class=MsoNormal>Usage</p>
  </td>
  <td width="84%" valign=top style='width:84.74%;padding:3.0pt 3.0pt 3.0pt 3.0pt'>
  <p class=MsoNormal><b>CONDITIONAL</b>, MAY be used once and only once</p>
  </td>
 </tr>
 <tr>
  <td width="15%" valign=top style='width:15.26%;background:#CCCCEE;padding:
  3.0pt 3.0pt 3.0pt 3.0pt'>
  <p class=MsoNormal>Definition</p>
  </td>
  <td width="84%" valign=top style='width:84.74%;padding:3.0pt 3.0pt 3.0pt 3.0pt'>
  <p class=MsoNormal>Resource home agency dispatch center name. This identifies
  the dispatch unit that has primary responsibility for maintaining information
  on the resource (e.g., Ft. Collins Dispatch Center, Rocky Mountain Area Coordination Center).&nbsp;</p>
  </td>
 </tr>
 <tr>
  <td width="15%" valign=top style='width:15.26%;background:#CCCCEE;padding:
  3.0pt 3.0pt 3.0pt 3.0pt'>
  <p class=MsoNormal>Comments</p>
  </td>
  <td width="84%" valign=top style='width:84.74%;padding:3.0pt 3.0pt 3.0pt 3.0pt'>
  <p class=MsoNormal style='margin-left:39.1pt;text-indent:-.25in'><span
  style='font-family:Wingdings'>§<span style='font:7.0pt "Times New Roman"'>&nbsp;
  </span></span>Conditional Usage:</p>
  <p class=MsoNormal style='margin-left:75.1pt;text-indent:-.25in'><span
  style='font-family:"Courier New"'>o<span style='font:7.0pt "Times New Roman"'>&nbsp;&nbsp;&nbsp;
  </span></span>Not Applicable:</p>
  <p class=MsoNormal style='margin-left:111.1pt;text-indent:-.25in'><span
  style='font-family:Wingdings'>§<span style='font:7.0pt "Times New Roman"'>&nbsp;
  </span></span><i>EDXLResourceMessage</i>:MessageContentType = “RequestResource”</p>
