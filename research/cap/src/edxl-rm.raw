<p class=MsoNormal><span lang=EN>&nbsp;</span></p>

<table class=MsoNormalTable border=1 cellspacing=0 cellpadding=0 width="97%"
 style='width:97.32%'>
 <tr>
  <td width="15%" valign=top style='width:15.92%;background:#CCCCEE;padding:
  3.0pt 3.0pt 3.0pt 3.0pt'>
  <p class=MsoNormal><b>Element</b></p>
  </td>
  <td width="84%" style='width:84.08%;padding:3.0pt 3.0pt 3.0pt 3.0pt'>
  <p class=MsoNormal>MessageDescription</p>
  </td>
 </tr>
 <tr>
  <td width="15%" valign=top style='width:15.92%;background:#CCCCEE;padding:
  3.0pt 3.0pt 3.0pt 3.0pt'>
  <p class=MsoNormal>Type</p>
  </td>
  <td width="84%" valign=top style='width:84.08%;padding:3.0pt 3.0pt 3.0pt 3.0pt'>
  <p class=MsoNormal>MessageDescriptionType [xsd:string]</p>
  </td>
 </tr>
 <tr>
  <td width="15%" valign=top style='width:15.92%;background:#CCCCEE;padding:
  3.0pt 3.0pt 3.0pt 3.0pt'>
  <p class=MsoNormal>Usage</p>
  </td>
  <td width="84%" valign=top style='width:84.08%;padding:3.0pt 3.0pt 3.0pt 3.0pt'>
  <p class=MsoNormal><b>CONDITIONAL</b>, MAY be used once and only once</p>
  </td>
 </tr>
 <tr>
  <td width="15%" valign=top style='width:15.92%;background:#CCCCEE;padding:
  3.0pt 3.0pt 3.0pt 3.0pt'>
  <p class=MsoNormal>Definition</p>
  </td>
  <td width="84%" valign=top style='width:84.08%;padding:3.0pt 3.0pt 3.0pt 3.0pt'>
  <p class=MsoNormal>Text field used to specify the information requested in a
  request for information and the response to a request for information. May
  also be used to include additional information in other message types.</p>
  </td>
 </tr>
 <tr>
  <td width="15%" valign=top style='width:15.92%;background:#CCCCEE;padding:
  3.0pt 3.0pt 3.0pt 3.0pt'>
  <p class=MsoNormal>Constraints</p>
  </td>
  <td width="84%" valign=top style='width:84.08%;padding:3.0pt 3.0pt 3.0pt 3.0pt'>
  <p class=MsoListBullet><span style='font-family:Symbol'>·<span
  style='font:7.0pt "Times New Roman"'>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
  </span></span>Conditional Usage:</p>
  <ul style='margin-top:0in' type=square>
   <ul style='margin-top:0in' type=circle>
    <li class=MsoNormal>Required:</li>
    <ul style='margin-top:0in' type=square>
     <li class=MsoNormal><i>EDXLResourceMessage</i>:MessageContentType = “RequestInformation”</li>
    </ul>
    <li class=MsoNormal>Optional:</li>
    <ul style='margin-top:0in' type=square>
     <li class=MsoNormal>Otherwise</li>
    </ul>
   </ul>
  </ul>
  </td>
 </tr>
 <tr>
  <td width="15%" valign=top style='width:15.92%;background:#CCCCEE;padding:
  3.0pt 3.0pt 3.0pt 3.0pt'>
  <p class=MsoNormal>Requirements</p>
  <p class=MsoNormal> Supported</p>
  </td>
  <td width="84%" style='width:84.08%;padding:3.0pt 3.0pt 3.0pt 3.0pt'>
  <p class=MsoNormal>20</p>
  </td>
 </tr>
