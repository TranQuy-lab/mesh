<!-- marquee: start -->
<section class="marquee"
		role="complementary"
		data-overlay="false"
		data-pattern="false"
		data-bg="true"
		style="--marquee-bg-image: url('https://tak.gov/assets/marquee/marquee-home-d8ffb9f7.jpg')">

	<!-- content: start -->
	<div class="container pb-0 position-relative text-center marquee__content">
		<div class="row">
			<div class="col-12 col-md-9 mx-auto">
				<h1 class="display-1 mb-4 fw-bold">Command the Cognitive High Ground with TAK</h1>
				<p class="lead homepage-lead mb-0 fw-bold-light">Gain intellectual overmatch with TAK - the advanced geospatial platform built to give your team a decisive edge in complex operational environments.</p>
				<p class="lead homepage-lead mb-0 mt-2 fw-bold-light">TAK delivers real-time data sharing, intuitive visualizations, and integrated planning and targeting tools, empowering operators to outthink, outmaneuver, and outpace any adversary.</p>
				<p class="lead homepage-lead mb-0 mt-2 fw-bold-light">Get mission-ready faster, make smarter decisions under pressure, and act with speed and precision. With TAK at the core of your operations, you achieve superior situational understanding when it matters most.</p>
				<button type="button"
						class="btn btn-primary mt-5 shadow-sm"
						data-bs-toggle="modal"
						data-bs-target="#homeVideo">
					<i class="ico-play-circle fs-4 me-2"></i>TAK INTRO
				</button>
			</div>
		</div>
	</div>
	<!-- content: start -->

