  border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;
  padding:0in 5.4pt 0in 5.4pt'>
  <p class=MsoNormal><span style='font-size:9.0pt'>Resource Consumer</span></p>
  </td>
 </tr>
 <tr style='page-break-inside:avoid'>
  <td width=127 style='width:95.4pt;border:solid windowtext 1.0pt;border-top:
  none;padding:0in 5.4pt 0in 5.4pt'>
  <p class=MsoNormal><span style='font-size:9.0pt'>RequestQuote</span></p>
  </td>
  <td width=420 valign=top style='width:315.0pt;border-top:none;border-left:
  none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;
  padding:0in 5.4pt 0in 5.4pt'>
  <p class=MsoNormal><span style='font-size:9.0pt'>Message used to request a
  price quote from a seller or supplier. </span></p>
  </td>
  <td width=91 valign=top style='width:.95in;border-top:none;border-left:none;
  border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;
  padding:0in 5.4pt 0in 5.4pt'>
  <p class=MsoNormal><span style='font-size:9.0pt'>Resource Consumer</span></p>
  </td>
 </tr>
 <tr style='page-break-inside:avoid'>
  <td width=127 style='width:95.4pt;border:solid windowtext 1.0pt;border-top:
  none;padding:0in 5.4pt 0in 5.4pt'>
  <p class=MsoNormal><span style='font-size:9.0pt'>ResponseToRequestQuote</span></p>
  </td>
  <td width=420 valign=top style='width:315.0pt;border-top:none;border-left:
  none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;
  padding:0in 5.4pt 0in 5.4pt'>
  <p class=MsoNormal><span style='font-size:9.0pt'>Message used as the response
  to a “RequestQuote”. Allows sender to list resource(s) which they feel
  represent suitable match with the request, with pricing information. </span></p>
  </td>
  <td width=91 valign=top style='width:.95in;border-top:none;border-left:none;
  border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;
  padding:0in 5.4pt 0in 5.4pt'>
  <p class=MsoNormal><span style='font-size:9.0pt'>Resource Supplier</span></p>
  </td>
 </tr>
 <tr style='page-break-inside:avoid'>
  <td width=127 style='width:95.4pt;border:solid windowtext 1.0pt;border-top:
  none;padding:0in 5.4pt 0in 5.4pt'>
  <p class=MsoNormal><span style='font-size:9.0pt'>RequestResourceDeploymentStatus</span></p>
  </td>
  <td width=420 valign=top style='width:315.0pt;border-top:none;border-left:
  none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;
  padding:0in 5.4pt 0in 5.4pt'>
  <p class=MsoNormal><span style='font-size:9.0pt'>Message used to request
  current “status” of resource. </span></p>
  </td>
  <td width=91 valign=top style='width:.95in;border-top:none;border-left:none;
  border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;
  padding:0in 5.4pt 0in 5.4pt'>
  <p class=MsoNormal><span style='font-size:9.0pt'>Resource Consumer,</span></p>
  <p class=MsoNormal><span style='font-size:9.0pt'>Resource Supplier</span></p>
  </td>
 </tr>
 <tr style='page-break-inside:avoid'>
  <td width=127 style='width:95.4pt;border:solid windowtext 1.0pt;border-top:
  none;padding:0in 5.4pt 0in 5.4pt'>
  <p class=MsoNormal><span style='font-size:9.0pt'>ReportResourceDeploymentStatus</span></p>
  </td>
  <td width=420 valign=top style='width:315.0pt;border-top:none;border-left:
  none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;
  padding:0in 5.4pt 0in 5.4pt'>
  <p class=MsoNormal><span style='font-size:9.0pt'>Message used to report on
  the current “status” of any resource. </span></p>
  </td>
  <td width=91 valign=top style='width:.95in;border-top:none;border-left:none;
  border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;
  padding:0in 5.4pt 0in 5.4pt'>
  <p class=MsoNormal><span style='font-size:9.0pt'>Resource Consumer,</span></p>
  <p class=MsoNormal><span style='font-size:9.0pt'>Resource Supplier</span></p>
  </td>
 </tr>
 <tr style='page-break-inside:avoid'>
  <td width=127 style='width:95.4pt;border:solid windowtext 1.0pt;border-top:
  none;padding:0in 5.4pt 0in 5.4pt'>
  <p class=MsoNormal><span style='font-size:9.0pt'>RequestExtendedDeploymentDuration</span></p>
  </td>
  <td width=420 valign=top style='width:315.0pt;border-top:none;border-left:
  none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;
  padding:0in 5.4pt 0in 5.4pt'>
  <p class=MsoNormal><span style='font-size:9.0pt'>A request initiated by the
  requester / receiver of resource, “I want to extend how long I need to keep
  this resource” </span></p>
  </td>
  <td width=91 valign=top style='width:.95in;border-top:none;border-left:none;
  border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;
  padding:0in 5.4pt 0in 5.4pt'>
  <p class=MsoNormal><span style='font-size:9.0pt'>Resource Consumer</span></p>
  </td>
 </tr>
 <tr style='page-break-inside:avoid'>
  <td width=127 style='width:95.4pt;border:solid windowtext 1.0pt;border-top:
  none;padding:0in 5.4pt 0in 5.4pt'>
  <p class=MsoNormal><span style='font-size:9.0pt'>ResponseToRequestExtendedDeployment
  Duration</span></p>
  </td>
  <td width=420 valign=top style='width:315.0pt;border-top:none;border-left:
  none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;
  padding:0in 5.4pt 0in 5.4pt'>
  <p class=MsoNormal><span style='font-size:9.0pt'>Message used as the response
  to “RequestExtendedDeploymentDuration”. </span></p>
  </td>
  <td width=91 valign=top style='width:.95in;border-top:none;border-left:none;
  border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;
  padding:0in 5.4pt 0in 5.4pt'>
  <p class=MsoNormal><span style='font-size:9.0pt'>Resource Supplier</span></p>
  </td>
 </tr>
</table>

<p class=MsoNormal>Table 1<span lang=EN> above and </span>Figure 3<span lang=EN> below are informative only. They are included to show how the resource
messages might flow between the Resource Consumer and Resource Supplier during
resource management. Note, however, that this specification does not prescribe the
sequence of message exchanges, except for some dependencies between messages
which are described in Section</span><span lang=EN>3.3</span><span lang=EN>.</span></p>

<p class=MsoNormal><span lang=EN>The Resource Messages can be used in three
phases of resource management:</span></p>

<p class=MsoListBullet><span lang=EN style='font-family:Symbol'>·<span
style='font:7.0pt "Times New Roman"'>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
</span></span><span lang=EN>Discovery,</span></p>

<p class=MsoListBullet><span lang=EN style='font-family:Symbol'>·<span
style='font:7.0pt "Times New Roman"'>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
</span></span><span lang=EN>Ordering, and</span></p>

<p class=MsoListBullet><span lang=EN style='font-family:Symbol'>·<span
style='font:7.0pt "Times New Roman"'>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
</span></span><span lang=EN>Deployment, as shown in </span>Figure 3<span lang=EN>.</span></p>

<p class=MsoNormal><span lang=EN>The Discovery phase enables Resource Consumers
to find out about available resources, including their costs, and offers of
resources from Resource Suppliers.</span></p>

<p class=MsoNormal><span lang=EN>The Ordering phase enables Resource Consumers
to explicitly requisition Resources from Resource Suppliers.</span></p>

<p class=MsoNormal><span lang=EN>The Deployment phase enables both actors to
find about the current status of resources in the field, request extensions and
returns.</span></p>

<p class=MsoNormal><span lang=EN>It is important to note that this specification
does not mandate an exact order and workflow of Resource Messages. For example,
the Ordering phase may actually only require the CommitResource message for
some actors.</span></p>

<p class=MsoNormal><span lang=EN><img border=0 width=624 height=445
src="EDXL-RM-v1.0-OS-errata-os_files/image004.jpg"></span></p>

<p class=MsoCaption><a name="_Ref153692070">Figure </a>3: Resource Message
Phases</p>

<p class=MsoNormal align=center style='text-align:center'><b><span lang=EN>&nbsp;</span></b></p>

<span lang=EN style='font-size:10.0pt;font-family:"Arial","sans-serif"'><br
clear=all style='page-break-before:always'>
</span>

<p class=MsoNormal>Table 2<span lang=EN> (below) summarizes all the Message
Types and their element contents. The </span>specific details on each of the
Message Types are outlined in the following sections.</p>

<p class=MsoNormal>&nbsp;</p>

